TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEADLESS=false
DATA_DIR=data
MAX_SEARCH_PAGES=100
REQUEST_DELAY_SECONDS=3
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
OZON_SEARCH_URL=https://www.ozon.ru/series/korol-na-vse-vremena-21102932/category/knigi-16500/?covertype=537&sorting=price
EXCLUDED_BOOKS_FILE=excluded_books.txt

# ID владельца, имеющего право менять настройки. Для личного чата можно оставить пустым:
# по умолчанию используется положительный TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_ID=
# Прокси необязательны. Системные VPN-маршруты сервис не меняет.
OZON_PROXY_URL=
TELEGRAM_PROXY_URL=
# Часовой пояс отчётов:
TZ=Asia/Novosibirsk
# UID/GID пользователя, владеющего каталогом data на сервере (для Docker build):
PUID=1000
PGID=1000
